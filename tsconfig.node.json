{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    // DOM is here for types only (noEmit). server/mcp.ts imports the module
    // service.ts files, which are shared with the browser and are written against
    // DOM fetch/Response — without it, res.json() resolves to unknown under the
    // Node undici types and every service fails to type-check.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "server/**/*.ts", "ecosystem.config.cjs"]
}
